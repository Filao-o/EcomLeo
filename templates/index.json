    "ct_faq_main": {
      "type": "ct-faq",
      "blocks": {
        "question_1": {
          "type": "question",
          "settings": {
            "question": "How is it different from a regular non-stick pan?",
            "answer": "<p>Regular non-stick pans depend on a chemical coating (PTFE) that wears out. CookingTitan pans have a titanium cooking surface with no coating, so there is nothing to peel, flake or replace.</p>"
          }
        },
        "question_2": {
          "type": "question",
          "settings": {
            "question": "Is titanium safe to cook with?",
            "answer": "<p>Yes. Titanium is extremely stable and doesn't react with food, even acidic sauces. And there's no PFAS or PTFE anywhere on the pan.</p>"
          }
        },
        "question_3": {
          "type": "question",
          "settings": {
            "question": "Can I use metal utensils?",
            "answer": "<p>Absolutely. Metal spatulas, whisks and tongs won't damage the hammered titanium surface.</p>"
          }
        },
        "question_4": {
          "type": "question",
          "settings": {
            "question": "Which heat sources does it work on?",
            "answer": "<p>Gas, electric, ceramic, induction, the oven (up to 540°C) and the grill.</p>"
          }
        },
        "question_5": {
          "type": "question",
          "settings": {
            "question": "Is it dishwasher safe?",
            "answer": "<p>Yes. Most of the time a rinse with warm soapy water is all it needs, because food slides off titanium.</p>"
          }
        },
        "question_6": {
          "type": "question",
          "settings": {
            "question": "Which size should I choose?",
            "answer": "<p>26 cm for 1 person, 28 cm for 1–2 people, 30 cm for 2–3 people. Each comes with or without a glass lid.</p>"
          }
        },
        "question_7": {
          "type": "question",
          "settings": {
            "question": "How fast is delivery to Australia?",
            "answer": "<p>Orders are dispatched within 24 hours and shipping is free across Australia. Your delivery estimate is shown at checkout.</p>"
          }
        },
        "question_8": {
          "type": "question",
          "settings": {
            "question": "What if it's not for me?",
            "answer": "<p>You have 30 days to send it back. Reach out and we'll take care of the rest.</p>"
          }
        }
      },
