    "ct_faq_main": {
      "type": "ct-faq",
      "blocks": {
        "question_1": {
          "type": "question",
          "settings": {
            "question": "How is CookingTitan different from a regular non-stick pan?",
            "answer": "<p>Regular non-stick pans rely on a synthetic coating that wears out. CookingTitan pans have a titanium cooking surface with no coating, so there's nothing to peel or flake off.</p>"
          }
        },
        "question_2": {
          "type": "question",
          "settings": {
            "question": "Is titanium safe to cook with?",
            "answer": "<p>Titanium is a very stable metal that doesn't react with food. Our pans are made without PFAS or PTFE coatings.</p>"
          }
        },
        "question_3": {
          "type": "question",
          "settings": {
            "question": "Can I use metal utensils?",
            "answer": "<p>Yes. The hammered titanium surface handles metal spatulas, tongs and whisks.</p>"
          }
        },
        "question_4": {
          "type": "question",
          "settings": {
            "question": "Which heat sources does it work on?",
            "answer": "<p>Gas, electric, ceramic, induction and the oven.</p>"
          }
        },
        "question_5": {
          "type": "question",
          "settings": {
            "question": "Is it dishwasher safe?",
            "answer": "<p>Yes. A quick wash with warm soapy water is usually all it needs, though.</p>"
          }
        },
        "question_6": {
          "type": "question",
          "settings": {
            "question": "Which size should I choose?",
            "answer": "<p>26 cm for 1 person, 28 cm for 1–2 people and 30 cm for 2–3 people. Each size comes with or without a glass lid.</p>"
          }
        },
        "question_7": {
          "type": "question",
          "settings": {
            "question": "How long does delivery to Australia take?",
            "answer": "<p>Orders ship within 24 hours and shipping across Australia is free. Your delivery estimate is shown at checkout.</p>"
          }
        },
        "question_8": {
          "type": "question",
          "settings": {
            "question": "What is your returns policy?",
            "answer": "<p>You have 30 days to return your pan. Get in touch and we'll walk you through it.</p>"
          }
        }
      },
      "block_order": [
