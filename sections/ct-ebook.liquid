{%- comment -%}
  Page de téléchargement de l'e-book (page non référencée, lien envoyé par e-mail après commande).
{%- endcomment -%}
{% render 'ct-sec-open', section: section %}
{%- assign s = section.settings -%}
<section class="ct-sec ct-eb">
  <div class="ct-wrap ct-eb__grid">
    <div class="ct-eb__visual">
      <div class="ct-eb__book">
        <div class="ct-eb__pages" aria-hidden="true"></div>
        <div class="ct-eb__cover">
          {%- if s.cover != blank -%}
            {{ s.cover | image_url: width: 900 | image_tag: class: 'ct-eb__img', loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 750px) 360px, 70vw', alt: s.cover.alt | default: s.heading }}
          {%- elsif s.cover_url != blank -%}
            <img class="ct-eb__img" src="{{ s.cover_url }}" alt="{{ s.heading | strip_html | escape }}" width="1200" height="1697" loading="eager">
          {%- else -%}
            <div class="ct-ph">{{ 'image' | placeholder_svg_tag }}</div>
          {%- endif -%}
          <span class="ct-eb__spine" aria-hidden="true"></span>
          <span class="ct-eb__shine" aria-hidden="true"></span>
        </div>
      </div>
      <div class="ct-eb__shadow" aria-hidden="true"></div>
    </div>

    <div class="ct-eb__content">
      {%- if s.eyebrow != blank -%}<p class="ct-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      {%- if s.heading != blank -%}<h1 class="ct-h2 ct-eb__title">{{ s.heading }}</h1>{%- endif -%}
      {%- if s.text != blank -%}<div class="ct-eb__text">{{ s.text }}</div>{%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="ct-eb__list">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>
              <span class="ct-check"><svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 6.5l2.5 2.5L10 3.5"/></svg></span>
              <span>{{ block.settings.text }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if s.button_label != blank and s.file_url != blank -%}
        <a class="ct-btn ct-eb__btn" href="{{ s.file_url }}" target="_blank" rel="noopener" download>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12"/><path d="M7 10l5 5 5-5"/><path d="M4 21h16"/></svg>
          {{ s.button_label }}
        </a>
      {%- endif -%}
      {%- if s.note != blank -%}<p class="ct-eb__note">{{ s.note }}</p>{%- endif -%}
    </div>
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .ct-eb__grid { display: grid; gap: 40px; align-items: center; }
  #shopify-section-{{ section.id }} .ct-eb__visual { position: relative; display: flex; flex-direction: column; align-items: center; perspective: 1600px; padding-top: 10px; }
  #shopify-section-{{ section.id }} .ct-eb__book { position: relative; width: min(66vw, 300px); aspect-ratio: 1200 / 1697; transform: rotateY(-22deg) rotateX(4deg); transform-style: preserve-3d; transition: transform .6s ease; }
  #shopify-section-{{ section.id }} .ct-eb__book:hover { transform: rotateY(-10deg) rotateX(2deg); }
  #shopify-section-{{ section.id }} .ct-eb__cover { position: absolute; inset: 0; border-radius: 2px 6px 6px 2px; overflow: hidden; box-shadow: 0 30px 60px rgba(0,0,0,.55), 0 8px 20px rgba(0,0,0,.35); transform: translateZ(14px); background: #f3ece2; }
  #shopify-section-{{ section.id }} .ct-eb__img { display: block; width: 100%; height: 100%; object-fit: cover; }
  #shopify-section-{{ section.id }} .ct-eb__spine { position: absolute; left: 0; top: 0; bottom: 0; width: 7%; background: linear-gradient(90deg, rgba(0,0,0,.28), rgba(255,255,255,.18) 45%, rgba(0,0,0,.08) 70%, transparent); }
  #shopify-section-{{ section.id }} .ct-eb__shine { position: absolute; inset: 0; background: linear-gradient(115deg, rgba(255,255,255,.22) 0%, transparent 38%, transparent 70%, rgba(255,255,255,.06)); pointer-events: none; }
  #shopify-section-{{ section.id }} .ct-eb__pages { position: absolute; top: 1.5%; bottom: 1.5%; right: -1px; width: 28px; transform: rotateY(90deg) translateZ(-14px); transform-origin: right; background: repeating-linear-gradient(90deg, #f6f1e8 0 2px, #ddd3c3 2px 3px); border-radius: 0 3px 3px 0; }
  #shopify-section-{{ section.id }} .ct-eb__shadow { width: min(60vw, 280px); height: 26px; margin-top: 18px; background: radial-gradient(ellipse at center, rgba(0,0,0,.6), transparent 70%); filter: blur(4px); }
  #shopify-section-{{ section.id }} .ct-eb__content { text-align: center; }
  #shopify-section-{{ section.id }} .ct-eb__title { margin: 0 0 14px; font-size: clamp(32px, 8.5vw, 52px); }
  #shopify-section-{{ section.id }} .ct-eb__text { color: rgba(255,255,255,.8); font-size: 16px; line-height: 1.65; margin-bottom: 22px; }
  #shopify-section-{{ section.id }} .ct-eb__text p { margin: 0 0 10px; }
  #shopify-section-{{ section.id }} .ct-eb__list { list-style: none; margin: 0 auto 28px; padding: 0; display: grid; gap: 12px; text-align: left; max-width: 420px; }
  #shopify-section-{{ section.id }} .ct-eb__list li { display: flex; gap: 12px; align-items: flex-start; color: rgba(255,255,255,.88); font-size: 15px; line-height: 1.45; }
  #shopify-section-{{ section.id }} .ct-eb__btn { max-width: 420px; margin: 0 auto; }
  #shopify-section-{{ section.id }} .ct-eb__note { margin: 14px 0 0; font-size: 13px; color: rgba(255,255,255,.55); }
  @media (min-width: 990px) {
    #shopify-section-{{ section.id }} .ct-eb__grid { grid-template-columns: 1fr 1fr; gap: 72px; max-width: 1080px; margin: 0 auto; }
    #shopify-section-{{ section.id }} .ct-eb__book { width: 360px; }
    #shopify-section-{{ section.id }} .ct-eb__shadow { width: 340px; }
    #shopify-section-{{ section.id }} .ct-eb__content { text-align: left; }
    #shopify-section-{{ section.id }} .ct-eb__list, #shopify-section-{{ section.id }} .ct-eb__btn { margin-left: 0; }
  }
</style>

{% schema %}
{
  "name": "⭐ E-book (téléchargement)",
  "tag": "section",
  "class": "ct-section",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "header", "content": "Livre" },
    { "type": "image_picker", "id": "cover", "label": "Couverture (image)", "info": "Laisser vide pour utiliser l'URL ci-dessous." },
    { "type": "text", "id": "cover_url", "label": "Couverture (URL de secours)", "default": "https://cdn.shopify.com/s/files/1/0804/2358/3941/files/titanium-ebook-cover.png" },
    { "type": "text", "id": "file_url", "label": "Lien du PDF", "default": "https://cdn.shopify.com/s/files/1/0804/2358/3941/files/The-Titanium-Book-Your-First-30-Days.pdf", "info": "URL du fichier dans Contenu → Fichiers." },
    { "type": "header", "content": "Texte" },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Your free gift" },
    { "type": "inline_richtext", "id": "heading", "label": "Titre", "default": "Your Titanium <em>eBook</em>" },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Thank you for your order. Here is your copy of The Titanium Book: your first 30 days with your new pan, from the first heat to your favourite recipes.</p>" },
    { "type": "text", "id": "button_label", "label": "Texte du bouton", "default": "Download the eBook" },
    { "type": "text", "id": "note", "label": "Note sous le bouton", "default": "PDF · 8 pages · Bookmark this page to download it again anytime." },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "background_color", "label": "Fond", "default": "#201f1e" },
    { "type": "color", "id": "accent_color", "label": "Couleur d'accent", "default": "#c8956c" },
    { "type": "range", "id": "padding_top", "label": "Marge haute", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Marge basse", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point clé",
      "settings": [ { "type": "text", "id": "text", "label": "Texte", "default": "First-use ritual" } ]
    }
  ],
  "presets": [ { "name": "⭐ E-book (téléchargement)" } ]
}
{% endschema %}
