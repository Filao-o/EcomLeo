{% render 'ct-sec-open', section: section %}
{%- assign s = section.settings -%}
<section class="ct-sec ct-rev" data-ct-carousel>
  <div class="ct-wrap">
    {% render 'ct-head', s: s %}
    {%- if s.show_stats -%}
      {%- if s.stat_1_value != blank or s.stat_2_value != blank or s.stat_3_value != blank or request.design_mode -%}
        <div class="ct-rev__stats">
          {%- for i in (1..3) -%}
            {%- assign kv = 'stat_' | append: i | append: '_value' -%}{%- assign kl = 'stat_' | append: i | append: '_label' -%}
            {%- if s[kv] != blank or request.design_mode -%}<div><strong>{{ s[kv] | default: '—' }}{% if i == 1 and s.stat_1_star and s[kv] != blank %} <span class="ct-rev__star">★</span>{% endif %}</strong><span>{{ s[kl] }}</span></div>{%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endif -%}
    <div class="ct-track" data-ct-track style="--ct-card-w: 84%; --ct-card-w-desk: 32%;">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <article class="ct-card ct-rev__card" {{ block.shopify_attributes }}>
          <div class="ct-rev__media">
            {%- if b.image != blank -%}{{ b.image | image_url: width: 700 | image_tag: class: 'ct-img', loading: 'lazy' }}{%- else -%}<div class="ct-ph">{{ "image" | placeholder_svg_tag }}</div>{%- endif -%}
            {%- if b.verified_label != blank -%}<span class="ct-rev__verified">✓ {{ b.verified_label }}</span>{%- endif -%}
          </div>
          <div class="ct-rev__body">
            <div class="ct-rev__top"><span class="ct-stars">{%- for i in (1..b.stars) -%}★{%- endfor -%}</span>{%- if b.date != blank -%}<span>{{ b.date }}</span>{%- endif -%}</div>
            {%- if b.quote != blank -%}<p class="ct-rev__quote">{{ b.quote }}</p>{%- endif -%}
            <div class="ct-rev__foot"><strong>{{ b.name }}</strong>{%- if b.location != blank -%}<span>{% render 'pdp-icon', icon: 'pin' %}{{ b.location }}</span>{%- endif -%}</div>
          </div>
        </article>
      {%- endfor -%}
    </div>
    <div class="ct-progress" data-ct-progress><span></span></div>
  </div>
</section>
<style>
  .ct-rev__stats { display: grid; grid-template-columns: repeat(3, 1fr); margin-bottom: 18px; padding: 16px 6px; border-radius: 10px; background: #161514; border: 1px solid var(--ct-border); }
  .ct-rev__stats div { display: flex; flex-direction: column; align-items: center; gap: 4px; text-align: center; padding: 0 6px; }
  .ct-rev__stats div + div { border-left: 1px solid var(--ct-border); }
  .ct-rev__stats strong { font-family: var(--font-heading-family); font-weight: 400; font-size: 22px; color: var(--ct-text); }
  .ct-rev__star { color: #f5b400; font-size: 16px; letter-spacing: 0; text-transform: none; }
  .ct-rev__stats span { font-size: 9.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--ct-muted); }
  .ct-rev__card { background: #161514; }
  .ct-rev__media { position: relative; aspect-ratio: 4 / 4.2; }
  .ct-rev__verified { position: absolute; top: 12px; right: 12px; padding: 5px 10px; border-radius: 100px; background: rgba(0,0,0,.6); font-size: 10px; letter-spacing: .1em; text-transform: uppercase; }
  .ct-rev__body { padding: 16px 18px 18px; }
  .ct-rev__top { display: flex; justify-content: space-between; align-items: center; font-size: 12px; color: var(--ct-muted); }
  .ct-rev__quote { margin: 10px 0 14px; font-style: italic; font-size: 14px; line-height: 1.55; color: rgba(255,255,255,.85); min-height: 4.6em; }
  .ct-rev__foot { display: flex; justify-content: space-between; align-items: center; padding-top: 12px; border-top: 1px solid var(--ct-border); font-size: 13px; }
  .ct-rev__foot span { display: inline-flex; align-items: center; gap: 4px; color: var(--ct-muted); font-size: 12px; }
  .ct-rev__foot .pdp-icon { width: 12px; height: 12px; }
</style>

{% schema %}
{
  "name": "⭐ Avis avec photos",
  "tag": "section",
  "class": "ct-section",
  "settings": [
    {
      "type": "header",
      "content": "En-tête"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sur-titre",
      "default": "Loved by home cooks"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Titre",
      "default": "The faces behind the <em>five stars</em>",
      "info": "Mets un mot en italique pour l'afficher en cuivre"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Sous-titre"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Alignement",
      "options": [
        {
          "value": "left",
          "label": "Gauche"
        },
        {
          "value": "center",
          "label": "Centré"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Statistiques (utilise tes vrais chiffres)"
    },
    {
      "type": "checkbox",
      "id": "show_stats",
      "label": "Afficher la barre de statistiques",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "stat_1_star",
      "label": "Étoile après la stat 1",
      "default": true
    },
    {
      "type": "text",
      "id": "stat_1_value",
      "label": "Stat 1 – valeur"
    },
    {
      "type": "text",
      "id": "stat_1_label",
      "label": "Stat 1 – libellé",
      "default": "Average rating"
    },
    {
      "type": "text",
      "id": "stat_2_value",
      "label": "Stat 2 – valeur"
    },
    {
      "type": "text",
      "id": "stat_2_label",
      "label": "Stat 2 – libellé",
      "default": "Verified reviews"
    },
    {
      "type": "text",
      "id": "stat_3_value",
      "label": "Stat 3 – valeur"
    },
    {
      "type": "text",
      "id": "stat_3_label",
      "label": "Stat 3 – libellé",
      "default": "4–5 star ratings"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Fond",
      "default": "#262423"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Couleur d'accent (optionnel)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espace en haut",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 56,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espace en bas",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 56,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Avis",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo du client"
        },
        {
          "type": "text",
          "id": "verified_label",
          "label": "Badge",
          "default": "Verified"
        },
        {
          "type": "range",
          "id": "stars",
          "label": "Étoiles",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "date",
          "label": "Date"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Avis (texte réel du client)",
          "default": "Paste a real customer review here."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Nom",
          "default": "Customer name"
        },
        {
          "type": "text",
          "id": "location",
          "label": "Lieu"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "⭐ Avis avec photos",
      "blocks": [
        {
          "type": "review"
        },
        {
          "type": "review"
        },
        {
          "type": "review"
        }
      ]
    }
  ],
  "enabled_on": {
    "templates": [
      "product",
      "index",
      "page"
    ]
  }
}
{% endschema %}
