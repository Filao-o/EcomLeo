{% render 'ct-sec-open', section: section %}
<section class="ct-sec ct-tb" data-ct-carousel>
  <div class="ct-wrap">
    {% render 'ct-head', s: section.settings %}
    <div class="ct-track ct-tb__track" data-ct-track style="--ct-card-w: 72%; --ct-card-w-desk: 24%;">
      {%- for block in section.blocks -%}
        <div class="ct-card ct-tb__card" {{ block.shopify_attributes }}>
          <span class="ct-tb__icon">{% render 'pdp-icon', icon: block.settings.icon %}</span>
          <h3>{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
    <div class="ct-dots ct-tb__dots" data-ct-dots>{%- for block in section.blocks -%}<button type="button" aria-label="{{ forloop.index }}"{% if forloop.first %} class="is-active"{% endif %}></button>{%- endfor -%}</div>
  </div>
</section>
<style>
  .ct-tb__card { padding: 22px 16px; text-align: center; background: #1a1917; }
  .ct-tb__icon { width: 46px; height: 46px; margin: 0 auto 12px; border-radius: 50%; background: rgba(200,149,108,.1); border: 1px solid rgba(200,149,108,.35); color: var(--ct-copper); display: flex; align-items: center; justify-content: center; }
  .ct-tb__icon .pdp-icon { width: 20px; height: 20px; }
  .ct-tb__card h3 { margin: 0 0 6px; font-size: 16px; font-weight: 600; color: var(--ct-text); font-family: var(--font-body-family); }
  .ct-tb__card p { margin: 0; font-size: 13px; color: var(--ct-muted); line-height: 1.45; }
  @media (min-width: 750px) { .ct-tb__track { overflow: visible; } .ct-tb__dots { display: none; } }
</style>

