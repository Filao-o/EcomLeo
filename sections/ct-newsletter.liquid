{% render 'ct-sec-open', section: section %}
{%- assign s = section.settings -%}
{%- assign nl_form_id = 'ct-nl-form-' | append: section.id -%}
<section class="ct-sec ct-nl">
  <div class="ct-wrap ct-nl__wrap">
    <div class="ct-card ct-nl__card">
      {%- if s.pill != blank -%}<p class="ct-nl__pill-wrap"><span class="ct-nl__pill"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3.5 6.5l8.5 6.5 8.5-6.5"/></svg>{{ s.pill }}</span></p>{%- endif -%}
      {% render 'ct-head', s: s %}
      {%- form 'customer', class: 'ct-nl__form', id: nl_form_id -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p class="ct-nl__ok">{{ s.success_text }}</p>
        {%- else -%}
          <div class="ct-nl__field">
            <input type="email" name="contact[email]" required autocomplete="email" placeholder="{{ s.placeholder }}" aria-label="{{ s.placeholder }}">
            <button type="submit" class="ct-btn ct-nl__btn">{{ s.button_label }}</button>
          </div>
          {%- if form.errors -%}<p class="ct-nl__err">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}
        {%- endif -%}
      {%- endform -%}
      <ul class="ct-nl__list">
        {%- for i in (1..3) -%}{%- assign k = 'point_' | append: i -%}
          {%- if s[k] != blank -%}<li><span class="ct-check"><svg viewBox="0 0 24 24"><path d="M6 12.5l4 4 8-9" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></span>{{ s[k] }}</li>{%- endif -%}
        {%- endfor -%}
      </ul>
      {%- if s.legal != blank -%}<div class="ct-nl__legal">{{ s.legal }}</div>{%- endif -%}
    </div>
  </div>
</section>
<style>
  .ct-nl__wrap { max-width: 640px; }
  .ct-nl__card { padding: 30px 22px; text-align: center; background: radial-gradient(120% 80% at 50% 0%, rgba(200,149,108,.12), transparent 60%), #1c1b1a; }
  .ct-nl__pill-wrap { margin: 0 0 14px; }
  .ct-nl__pill { display: inline-flex; align-items: center; gap: 8px; padding: 6px 14px; border-radius: 100px; border: 1px solid rgba(200,149,108,.4); color: var(--ct-copper); font-size: 11px; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; }
  .ct-nl__pill svg { width: 15px; height: 15px; }
  .ct-nl .ct-head { text-align: center; } .ct-nl .ct-sub { margin-left: auto; margin-right: auto; }
  .ct-nl__field { display: flex; gap: 8px; margin: 4px 0 16px; }
  .ct-nl__field input { flex: 1; min-width: 0; padding: 14px 16px; border-radius: 6px; border: 1px solid var(--ct-border); background: #121110; color: #fff; font: inherit; font-size: 15px; }
  .ct-nl__field input:focus { outline: none; border-color: var(--ct-copper); }
  .ct-nl__btn { width: auto; padding: 14px 18px; font-size: 12px; }
  @media (max-width: 480px) { .ct-nl__field { flex-direction: column; } .ct-nl__btn { width: 100%; } }
  .ct-nl__ok { margin: 8px 0 16px; color: #4ade80; }
  .ct-nl__err { margin: -8px 0 12px; color: #e5533d; font-size: 13px; }
  .ct-nl__list { list-style: none; padding: 0; margin: 0 0 14px; display: flex; flex-direction: column; align-items: center; gap: 8px; }
  .ct-nl__list li { display: inline-flex; gap: 8px; align-items: center; color: var(--ct-muted); font-size: 13.5px; }
  .ct-nl__list .ct-check { width: 16px; height: 16px; }
  .ct-nl__legal { color: rgba(255,255,255,.4); font-size: 12px; }
  .ct-nl__legal p { margin: 0; } .ct-nl__legal a { color: rgba(255,255,255,.6); }
</style>

{% schema %}
{
  "name": "⭐ Newsletter",
  "tag": "section",
  "class": "ct-section",
  "enabled_on": {
    "templates": [
      "*"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "pill",
      "label": "Pastille",
      "default": "Newsletter"
    },
    {
      "type": "header",
      "content": "En-tête"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sur-titre"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Titre",
      "default": "Stay in the <em>loop</em>",
      "info": "Mets un mot en italique pour l'afficher en cuivre"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Sous-titre",
      "default": "New releases, recipes and members-only offers, straight to your inbox."
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Alignement",
      "options": [
        {
          "value": "left",
          "label": "Gauche"
        },
        {
          "value": "center",
          "label": "Centré"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Formulaire"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Texte du champ",
      "default": "Your email address"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Bouton",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "Message de confirmation",
      "default": "Thanks! You're on the list."
    },
    {
      "type": "header",
      "content": "Avantages"
    },
    {
      "type": "text",
      "id": "point_1",
      "label": "Avantage 1",
      "default": "First access to new releases"
    },
    {
      "type": "text",
      "id": "point_2",
      "label": "Avantage 2",
      "default": "Recipes and cooking tips"
    },
    {
      "type": "text",
      "id": "point_3",
      "label": "Avantage 3",
      "default": "No spam, unsubscribe anytime"
    },
    {
      "type": "richtext",
      "id": "legal",
      "label": "Mention légale",
      "default": "<p>By subscribing you agree to our <a href=\"/policies/privacy-policy\">Privacy Policy</a>.</p>"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Fond",
      "default": "#201f1e"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Couleur d'accent (optionnel)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espace en haut",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espace en bas",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 56,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "⭐ Newsletter"
    }
  ]
}
{% endschema %}
