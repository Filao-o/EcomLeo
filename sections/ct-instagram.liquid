{% render 'ct-sec-open', section: section %}
{%- assign s = section.settings -%}
<section class="ct-sec ct-ig">
  <div class="ct-wrap">
    <div class="ct-card ct-ig__profile">
      <div class="ct-ig__top">
        <span class="ct-ig__avatar">{%- if s.avatar != blank -%}{{ s.avatar | image_url: width: 160 | image_tag: alt: s.name }}{%- endif -%}</span>
        <div>
          {%- if s.eyebrow != blank -%}<p class="ct-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
          <p class="ct-ig__name">{{ s.name }}{% if s.verified %} <svg class="ct-ig__badge" viewBox="0 0 24 24"><path fill="#3897f0" d="M12 1.5l2.6 1.9 3.2-.1 1 3.1 2.6 1.9-1 3.1 1 3.1-2.6 1.9-1 3.1-3.2-.1L12 22.5l-2.6-1.9-3.2.1-1-3.1-2.6-1.9 1-3.1-1-3.1 2.6-1.9 1-3.1 3.2.1z"/><path fill="#fff" d="M10.6 15.6l-3.2-3.2 1.4-1.4 1.8 1.8 4.6-4.6 1.4 1.4z"/></svg>{% endif %}</p>
          {%- if s.bio != blank -%}<p class="ct-ig__bio">{{ s.bio }}</p>{%- endif -%}
        </div>
      </div>
      {%- if s.stat_1_value != blank -%}
        <div class="ct-ig__stats">
          {%- for i in (1..3) -%}{%- assign kv = 'stat_' | append: i | append: '_value' -%}{%- assign kl = 'stat_' | append: i | append: '_label' -%}
            {%- if s[kv] != blank -%}<div><strong>{{ s[kv] }}</strong><span>{{ s[kl] }}</span></div>{%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
      {%- if s.button_label != blank -%}<a class="ct-ig__btn" href="{{ s.button_url | default: '#' }}" target="_blank" rel="noopener">{% render 'pdp-icon', icon: 'instagram' %}{{ s.button_label }}</a>{%- endif -%}
    </div>
    <div class="ct-ig__grid">
      {%- for block in section.blocks -%}
        <a class="ct-ig__item" href="{{ block.settings.link | default: s.button_url | default: '#' }}" target="_blank" rel="noopener" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 400 | image_tag: class: 'ct-img', loading: 'lazy' }}{%- else -%}<div class="ct-ph">{{ "image" | placeholder_svg_tag }}</div>{%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
<style>
  .ct-ig__profile { padding: 22px; background: #1f1e1c; }
  .ct-ig__top { display: flex; gap: 16px; align-items: flex-start; }
  .ct-ig__avatar { flex: none; width: 72px; height: 72px; border-radius: 50%; padding: 3px; background: linear-gradient(45deg, #f9ce34, #ee2a7b, #6228d7); }
  .ct-ig__avatar img { width: 100%; height: 100%; border-radius: 50%; object-fit: cover; border: 2px solid #1f1e1c; }
  .ct-ig__name { margin: 0 0 6px; font-size: 20px; font-weight: 700; display: flex; align-items: center; gap: 6px; }
  .ct-ig__badge { width: 18px; height: 18px; }
  .ct-ig__bio { margin: 0; color: var(--ct-muted); font-size: 14px; line-height: 1.5; }
  .ct-ig__stats { display: grid; grid-template-columns: repeat(3, 1fr); margin: 18px 0; padding-top: 16px; border-top: 1px solid var(--ct-border); text-align: center; }
  .ct-ig__stats strong { display: block; font-size: 18px; } .ct-ig__stats span { font-size: 12px; color: var(--ct-muted); }
  .ct-ig__btn { display: flex; align-items: center; justify-content: center; gap: 10px; padding: 14px; border-radius: 6px; background: #f5f0eb; color: #1a1410; font-weight: 700; font-size: 15px; text-decoration: none; }
  .ct-ig__btn .pdp-icon { width: 20px; height: 20px; }
  .ct-ig__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 4px; margin-top: 14px; }
  .ct-ig__item { aspect-ratio: 1; border-radius: 4px; overflow: hidden; display: block; }
</style>

{% schema %}
{
  "name": "⭐ Instagram",
  "tag": "section",
  "class": "ct-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "avatar",
      "label": "Photo de profil"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sur-titre",
      "default": "Follow us"
    },
    {
      "type": "text",
      "id": "name",
      "label": "Nom du compte",
      "default": "CookingTitan"
    },
    {
      "type": "checkbox",
      "id": "verified",
      "label": "Badge vérifié",
      "default": false
    },
    {
      "type": "textarea",
      "id": "bio",
      "label": "Bio",
      "default": "Write your Instagram bio here."
    },
    {
      "type": "header",
      "content": "Statistiques (vrais chiffres)"
    },
    {
      "type": "text",
      "id": "stat_1_value",
      "label": "Stat 1"
    },
    {
      "type": "text",
      "id": "stat_1_label",
      "label": "Libellé 1",
      "default": "Posts"
    },
    {
      "type": "text",
      "id": "stat_2_value",
      "label": "Stat 2"
    },
    {
      "type": "text",
      "id": "stat_2_label",
      "label": "Libellé 2",
      "default": "Followers"
    },
    {
      "type": "text",
      "id": "stat_3_value",
      "label": "Stat 3"
    },
    {
      "type": "text",
      "id": "stat_3_label",
      "label": "Libellé 3",
      "default": "Following"
    },
    {
      "type": "header",
      "content": "Bouton"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texte",
      "default": "Follow us on Instagram"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Lien du profil"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Fond",
      "default": "#262423"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Couleur d'accent (optionnel)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espace en haut",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 56,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espace en bas",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 56,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Publication",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Lien (optionnel)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "⭐ Instagram",
      "blocks": [
        {
          "type": "post"
        },
        {
          "type": "post"
        },
        {
          "type": "post"
        },
        {
          "type": "post"
        },
        {
          "type": "post"
        },
        {
          "type": "post"
        },
        {
          "type": "post"
        },
        {
          "type": "post"
        }
      ]
    }
  ],
  "enabled_on": {
    "templates": [
      "product",
      "index",
      "page"
    ]
  }
}
{% endschema %}
