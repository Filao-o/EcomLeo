{% render 'ct-sec-open', section: section %}
<section class="ct-sec ct-ic" data-ct-carousel>
  <div class="ct-wrap">
    {% render 'ct-head', s: section.settings %}
    <div class="ct-track" data-ct-track style="--ct-card-w: 86%; --ct-card-w-desk: 32%;">
      {%- for block in section.blocks -%}
        {%- if block.type == 'card' -%}
          <article class="ct-card ct-ic__card" {{ block.shopify_attributes }}>
            <div class="ct-ic__media">
              {%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 800 | image_tag: class: 'ct-img', loading: 'lazy' }}{%- else -%}<div class="ct-ph">{{ "image" | placeholder_svg_tag }}</div>{%- endif -%}
              <span class="ct-ic__icon">{% render 'pdp-icon', icon: block.settings.icon %}</span>
            </div>
            <div class="ct-ic__body">
              {%- if block.settings.title != blank -%}<h3>{{ block.settings.title }}</h3>{%- endif -%}
              {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
            </div>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
    <div class="ct-progress" data-ct-progress><span></span></div>
    {%- assign has_icons = false -%}
    {%- for block in section.blocks -%}{%- if block.type == 'heat_icon' -%}{%- assign has_icons = true -%}{%- endif -%}{%- endfor -%}
    {%- if has_icons -%}
      <div class="ct-ic__row">
        {%- for block in section.blocks -%}
          {%- if block.type == 'heat_icon' -%}
            <div {{ block.shopify_attributes }}>{% render 'pdp-icon', icon: block.settings.icon %}<span>{{ block.settings.label }}</span></div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>
<style>
  .ct-ic__card { background: #1a1917; }
  .ct-ic__media { position: relative; aspect-ratio: 4 / 3.4; }
  .ct-ic__icon { position: absolute; left: 16px; bottom: -18px; width: 40px; height: 40px; border-radius: 50%; background: #1a1917; border: 1px solid var(--ct-border); color: var(--ct-copper); display: flex; align-items: center; justify-content: center; }
  .ct-ic__icon .pdp-icon { width: 18px; height: 18px; }
  .ct-ic__body { padding: 28px 18px 20px; }
  .ct-ic__body h3 { margin: 0 0 6px; font-family: var(--font-heading-family); font-weight: 400; font-size: 21px; color: var(--ct-text); }
  .ct-ic__body p { margin: 0; color: var(--ct-muted); font-size: 14px; line-height: 1.5; }
  .ct-ic__row { display: flex; justify-content: space-around; gap: 8px; margin-top: 26px; padding-top: 22px; border-top: 1px solid var(--ct-border); }
  .ct-ic__row div { display: flex; flex-direction: column; align-items: center; gap: 6px; font-size: 12px; color: var(--ct-muted); }
  .ct-ic__row .pdp-icon { width: 20px; height: 20px; color: var(--ct-copper); }
</style>

