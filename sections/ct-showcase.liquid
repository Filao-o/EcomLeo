{% render 'ct-sec-open', section: section %}
{%- assign s = section.settings -%}
<section class="ct-sec ct-show">
  <div class="ct-wrap">
    {% render 'ct-head', s: s %}
    <div class="ct-show__media{% if s.media_ratio != blank %} ct-show__media--{{ s.media_ratio }}{% endif %}">
      {%- if s.video != blank -%}
        {%- if s.video_autoplay -%}
          {{ s.video | video_tag: autoplay: true, muted: true, loop: true, playsinline: true, controls: false, preload: 'metadata', class: 'ct-img ct-show__video', image_size: '1400x' }}
        {%- else -%}
          {{ s.video | video_tag: controls: true, playsinline: true, preload: 'metadata', class: 'ct-img ct-show__video', image_size: '1400x' }}
        {%- endif -%}
      {%- elsif s.video_url != blank -%}
        {%- if s.video_autoplay -%}
          {{ s.video_url | external_video_url: autoplay: 1, mute: 1, loop: 1, playsinline: 1, controls: 0 | external_video_tag: class: 'ct-show__embed' }}
        {%- else -%}
          {{ s.video_url | external_video_tag: class: 'ct-show__embed' }}
        {%- endif -%}
      {%- elsif s.image != blank -%}{{ s.image | image_url: width: 1400 | image_tag: class: 'ct-img', loading: 'lazy', sizes: '100vw' }}{%- else -%}<div class="ct-ph">{{ "image" | placeholder_svg_tag }}</div>{%- endif -%}
    </div>
    {%- if section.blocks.size > 0 -%}
      <div class="ct-show__cards">
        {%- for block in section.blocks -%}
          <div class="ct-card ct-show__card" {{ block.shopify_attributes }}>
            <span class="ct-show__icon">{%- if block.settings.icon_image != blank -%}{{ block.settings.icon_image | image_url: width: 80 | image_tag: alt: '' }}{%- elsif block.settings.icon_text != blank -%}<b>{{ block.settings.icon_text }}</b>{%- else -%}{% render 'pdp-icon', icon: block.settings.icon %}{%- endif -%}</span>
            {%- if block.settings.title != blank -%}<h3>{{ block.settings.title }}</h3>{%- endif -%}
            {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
    {%- if s.link_label != blank -%}<p class="ct-show__link"><a href="{{ s.link_url | default: '#' }}">{% render 'pdp-icon', icon: 'document' %}{{ s.link_label }}</a></p>{%- endif -%}
  </div>
</section>
<style>
  .ct-show__media { aspect-ratio: 4 / 5; border-radius: 12px; overflow: hidden; background: radial-gradient(circle at 50% 40%, #2a2722, #0f0e0d); }
  @media (min-width: 750px) { .ct-show__media { aspect-ratio: 16 / 9; } }
  .ct-show__media--square { aspect-ratio: 1 / 1 !important; }
  .ct-show__media--landscape { aspect-ratio: 16 / 9 !important; }
  .ct-show__media--portrait { aspect-ratio: 4 / 5 !important; }
  .ct-show__media { position: relative; }
  .ct-show__video { object-fit: cover; }
  .ct-show__embed { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .ct-show__cards { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 10px; margin-top: 12px; }
  .ct-show__card { padding: 18px 12px; text-align: center; background: #1a1917; }
  .ct-show__icon { width: 40px; height: 40px; margin: 0 auto 10px; border-radius: 8px; border: 1px solid rgba(200,149,108,.4); background: rgba(200,149,108,.1); color: var(--ct-copper); display: flex; align-items: center; justify-content: center; font-family: var(--font-heading-family); }
  .ct-show__icon .pdp-icon { width: 20px; height: 20px; }
  .ct-show__icon img { width: 22px; height: 22px; object-fit: contain; }
  .ct-show__card h3 { margin: 0 0 6px; font-size: 15px; font-weight: 600; color: var(--ct-text); font-family: var(--font-body-family); }
  .ct-show__card p { margin: 0; font-size: 12.5px; color: var(--ct-muted); line-height: 1.45; }
  .ct-show__link { text-align: center; margin: 16px 0 0; }
  .ct-show__link a { display: inline-flex; align-items: center; gap: 8px; color: var(--ct-text); font-size: 14px; text-decoration: underline; text-underline-offset: 4px; text-decoration-color: rgba(255,255,255,.3); }
  .ct-show__link .pdp-icon { width: 16px; height: 16px; color: var(--ct-copper); }
</style>

{% schema %}
{
  "name": "⭐ Visuel + cartes",
  "tag": "section",
  "class": "ct-section",
  "settings": [
    {
      "type": "header",
      "content": "En-tête"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sur-titre"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Titre",
      "default": "Built to be the last pan you <em>buy</em>",
      "info": "Mets un mot en italique pour l'afficher en cuivre"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Sous-titre",
      "default": "Hand-hammered titanium. No coating to wear off."
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Alignement",
      "options": [
        {
          "value": "left",
          "label": "Gauche"
        },
        {
          "value": "center",
          "label": "Centré"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Visuel (image ou vidéo)"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image principale",
      "info": "Affichée si aucune vidéo n'est choisie (et comme aperçu)"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Vidéo (hébergée sur Shopify)",
      "info": "Remplace l'image si elle est renseignée"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "Ou vidéo YouTube / Vimeo",
      "accept": [
        "youtube",
        "vimeo"
      ]
    },
    {
      "type": "checkbox",
      "id": "video_autoplay",
      "label": "Lecture automatique en boucle (sans son)",
      "default": true
    },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "Format du visuel",
      "options": [
        {
          "value": "auto",
          "label": "Automatique (portrait mobile, paysage ordinateur)"
        },
        {
          "value": "portrait",
          "label": "Portrait 4:5"
        },
        {
          "value": "square",
          "label": "Carré"
        },
        {
          "value": "landscape",
          "label": "Paysage 16:9"
        }
      ],
      "default": "auto"
    },
    {
      "type": "header",
      "content": "Lien"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Texte du lien"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Lien"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Fond",
      "default": "#141312"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Couleur d'accent (optionnel)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espace en haut",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 56,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espace en bas",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 56,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Carte",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icône",
          "options": [
            {
              "value": "none",
              "label": "Aucune"
            },
            {
              "value": "check_circle",
              "label": "Coche"
            },
            {
              "value": "shield",
              "label": "Bouclier"
            },
            {
              "value": "truck",
              "label": "Camion"
            },
            {
              "value": "return",
              "label": "Retour"
            },
            {
              "value": "lock",
              "label": "Cadenas"
            },
            {
              "value": "flame",
              "label": "Flamme"
            },
            {
              "value": "gas_stove",
              "label": "Gaz"
            },
            {
              "value": "induction",
              "label": "Induction"
            },
            {
              "value": "oven",
              "label": "Four"
            },
            {
              "value": "grill",
              "label": "Grill"
            },
            {
              "value": "electric",
              "label": "Électrique"
            },
            {
              "value": "ceramic",
              "label": "Vitrocéramique"
            },
            {
              "value": "star",
              "label": "Étoile"
            },
            {
              "value": "heart",
              "label": "Cœur"
            },
            {
              "value": "medal",
              "label": "Médaille"
            },
            {
              "value": "leaf",
              "label": "Feuille"
            },
            {
              "value": "drop",
              "label": "Goutte"
            },
            {
              "value": "box",
              "label": "Boîte"
            },
            {
              "value": "document",
              "label": "Document"
            },
            {
              "value": "gift",
              "label": "Cadeau"
            }
          ],
          "default": "shield"
        },
        {
          "type": "text",
          "id": "icon_text",
          "label": "Ou texte dans l'icône (ex : Ti)"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Ou image d'icône"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titre",
          "default": "Long-lasting build"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Texte",
          "default": "Describe what makes it last."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "⭐ Visuel + cartes",
      "blocks": [
        {
          "type": "card"
        },
        {
          "type": "card",
          "settings": {
            "icon_text": "Ti",
            "title": "Real titanium",
            "text": "Describe your material here."
          }
        }
      ]
    }
  ],
  "enabled_on": {
    "templates": [
      "product",
      "index",
      "page"
    ]
  }
}
{% endschema %}
