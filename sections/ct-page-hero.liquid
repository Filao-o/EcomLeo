{% render 'ct-sec-open', section: section %}
<section class="ct-sec ct-ph-hero">
  <div class="ct-wrap">{% render 'ct-head', s: section.settings %}</div>
</section>
<style>
  #shopify-section-{{ section.id }} .ct-h2 { font-size: clamp(34px, 9vw, 56px); }
  #shopify-section-{{ section.id }} .ct-head { margin: 0; }
</style>

{% schema %}
{
  "name": "⭐ En-tête de page",
  "tag": "section",
  "class": "ct-section",
  "enabled_on": {
    "templates": [
      "*"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "En-tête"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sur-titre",
      "default": "Support"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Titre",
      "default": "Let's <em>talk</em>",
      "info": "Mets un mot en italique pour l'afficher en cuivre"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Sous-titre",
      "default": "Questions about your order, your pan or anything else? We're here to help."
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Alignement",
      "options": [
        {
          "value": "left",
          "label": "Gauche"
        },
        {
          "value": "center",
          "label": "Centré"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Fond",
      "default": "#201f1e"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Couleur d'accent (optionnel)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espace en haut",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 56,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espace en bas",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 24,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "⭐ En-tête de page"
    }
  ]
}
{% endschema %}
