{% render 'ct-sec-open', section: section %}
<section class="ct-sec ct-so">
  <div class="ct-wrap">
    {% render 'ct-head', s: section.settings %}
    <div class="ct-so__grid">
      {%- for block in section.blocks -%}
        <a class="ct-card ct-so__item" href="{{ block.settings.link | default: '#' }}" target="_blank" rel="noopener" {{ block.shopify_attributes }}>
          <span class="ct-so__icon">{% render 'pdp-icon', icon: block.settings.icon %}</span>
          <span><span class="ct-so__name">{{ block.settings.name }}</span><span class="ct-so__handle">{{ block.settings.handle }}</span></span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
<style>
  .ct-so__grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 10px; }
  @media (min-width: 750px) { .ct-so__grid { grid-template-columns: repeat(4, minmax(0,1fr)); } }
  .ct-so__item { display: flex; align-items: center; gap: 12px; padding: 14px; background: #1a1917; text-decoration: none; transition: border-color .2s; }
  .ct-so__item:hover { border-color: var(--ct-copper); }
  .ct-so__icon { flex: none; width: 38px; height: 38px; border-radius: 10px; background: rgba(255,255,255,.05); color: var(--ct-text); display: flex; align-items: center; justify-content: center; }
  .ct-so__icon .pdp-icon { width: 18px; height: 18px; }
  .ct-so__name { display: block; font-size: 14px; font-weight: 600; color: var(--ct-text); }
  .ct-so__handle { display: block; font-size: 12px; color: var(--ct-muted); }
</style>

