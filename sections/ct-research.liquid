{% render 'ct-sec-open', section: section %}
{%- assign s = section.settings -%}
<section class="ct-sec ct-res" style="--ct-text: {{ s.text_color }}; --ct-muted: {{ s.muted_color }};">
  <div class="ct-wrap ct-res__wrap">
    {%- if s.pill != blank -%}<p class="ct-res__pill-wrap"><span class="ct-res__pill">{% render 'pdp-icon', icon: s.pill_icon %}{{ s.pill }}</span></p>{%- endif -%}
    {% render 'ct-head', s: s %}
    <ul class="ct-res__list">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}><span class="ct-check"><svg viewBox="0 0 24 24"><path d="M6 12.5l4 4 8-9" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span><strong>{{ block.settings.title }}</strong>{% if block.settings.text != blank %} — {{ block.settings.text }}{% endif %}</span></li>
      {%- endfor -%}
    </ul>
    {%- if s.footnote != blank -%}<div class="ct-res__note">{{ s.footnote }}</div>{%- endif -%}
    {%- if s.button_label != blank -%}<a class="ct-btn ct-btn--ghost ct-res__btn" href="{{ s.button_url | default: '#' }}">{{ s.button_label }} →</a>{%- endif -%}
  </div>
</section>
<style>
  .ct-res__wrap { max-width: 720px; }
  .ct-res__pill-wrap { text-align: center; margin: 0 0 16px; }
  .ct-res__pill { display: inline-flex; align-items: center; gap: 8px; padding: 6px 16px; border-radius: 100px; border: 1px solid rgba(166,124,82,.4); color: #a67c52; font-size: 11px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; }
  .ct-res__pill .pdp-icon { width: 14px; height: 14px; }
  .ct-res .ct-head { text-align: center; } .ct-res .ct-sub { margin-left: auto; margin-right: auto; }
  .ct-res__list { list-style: none; padding: 0; margin: 22px 0; display: grid; gap: 14px; }
  .ct-res__list li { display: flex; gap: 12px; align-items: flex-start; color: var(--ct-muted); font-size: 15px; line-height: 1.55; }
  .ct-res__list .ct-check { margin-top: 3px; color: #fff; }
  .ct-res__list strong { color: var(--ct-text); }
  .ct-res__note { padding-top: 18px; border-top: 1px solid rgba(0,0,0,.12); text-align: center; color: var(--ct-muted); font-size: 13.5px; }
  .ct-res__note p { margin: 0; } .ct-res__note strong { color: var(--ct-text); }
  .ct-res__btn { margin-top: 18px; color: var(--ct-text); border-color: var(--ct-text); }
</style>

