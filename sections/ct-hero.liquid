{{ 'ct-sections.css' | asset_url | stylesheet_tag }}
{%- assign s = section.settings -%}
<section class="ct-hero ct-hero--{{ section.id }}">
  <div class="ct-hero__bg">
    {%- if s.video != blank -%}
      {{ s.video | video_tag: autoplay: true, muted: true, loop: true, playsinline: true, controls: false, preload: 'metadata', image_size: '1600x' }}
    {%- elsif s.image != blank -%}
      {%- if s.image_mobile != blank -%}
        {{ s.image_mobile | image_url: width: 900 | image_tag: class: 'ct-hero__img ct-hero__img--mobile', loading: 'eager', fetchpriority: 'high', alt: s.image_mobile.alt }}
      {%- endif -%}
      {{ s.image | image_url: width: 2000 | image_tag: class: 'ct-hero__img ct-hero__img--desktop', loading: 'eager', fetchpriority: 'high', sizes: '100vw', alt: s.image.alt }}
    {%- else -%}
      <div class="ct-hero__ph"></div>
    {%- endif -%}
  </div>
  <div class="ct-hero__overlay"></div>
  <div class="ct-hero__gradient"></div>
  {%- if s.grain -%}<div class="ct-hero__grain"></div>{%- endif -%}
  <div class="ct-hero__content">
    {%- if s.tag != blank -%}<p class="ct-hero__tag">{{ s.tag }}</p>{%- endif -%}
    {%- if s.heading != blank -%}<h1 class="ct-hero__title">{{ s.heading }}</h1>{%- endif -%}
    {%- if s.subheading != blank -%}<p class="ct-hero__sub">{{ s.subheading }}</p>{%- endif -%}
    <div class="ct-hero__ctas">
      {%- if s.button_label != blank -%}<a class="ct-btn ct-hero__btn" href="{{ s.button_url | default: '/collections/all' }}">{{ s.button_label }} <span aria-hidden="true">→</span></a>{%- endif -%}
      {%- if s.button2_label != blank -%}<a class="ct-btn ct-btn--ghost ct-hero__btn" href="{{ s.button2_url | default: '#' }}">{{ s.button2_label }}</a>{%- endif -%}
    </div>
    {%- if s.rating_text != blank -%}
      <p class="ct-hero__rating"><span class="ct-hero__pill"><span class="ct-stars">★★★★★</span><span>{{ s.rating_text }}</span></span></p>
    {%- endif -%}
  </div>
  {%- if s.show_scroll -%}
    <div class="ct-hero__scroll" aria-hidden="true"><span>{{ s.scroll_label }}</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 5v14M6 13l6 6 6-6"/></svg></div>
  {%- endif -%}
</section>
<style>
  .ct-hero--{{ section.id }} {
    --hero-min-d: {{ s.height_desktop }}px; --hero-min-m: {{ s.height_mobile }}px;
    --hero-overlay: {{ s.overlay_opacity | divided_by: 100.0 }};
  }
  .ct-hero { position: relative; min-height: var(--hero-min-d); display: flex; align-items: center; overflow: hidden; background: #141414; color: #f5f0eb; font-family: var(--font-body-family); }
  .ct-hero__bg, .ct-hero__overlay, .ct-hero__gradient, .ct-hero__grain { position: absolute; inset: 0; }
  .ct-hero__bg img, .ct-hero__bg video { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ct-hero__ph { width: 100%; height: 100%; background: radial-gradient(circle at 65% 40%, #3a3835, #141414 70%); }
  .ct-hero__img--mobile { display: none !important; }
  .ct-hero__overlay { background: #141414; opacity: var(--hero-overlay); z-index: 1; }
  .ct-hero__gradient { z-index: 1; pointer-events: none; background: linear-gradient(135deg, rgba(20,20,20,.8) 0%, transparent 50%, rgba(20,20,20,.7) 100%); }
  .ct-hero__grain { z-index: 2; opacity: .035; pointer-events: none; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='g'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23g)'/%3E%3C/svg%3E"); }
  .ct-hero__content { position: relative; z-index: 3; max-width: 680px; padding: 80px 60px; }
  .ct-hero__tag { display: inline-flex; align-items: center; gap: 8px; margin: 0 0 18px; padding: 6px 12px; border-radius: 4px; border: 1px solid rgba(200,149,108,.35); background: rgba(200,149,108,.08); color: var(--ct-copper, #c8956c); font-size: 11px; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; }
  .ct-hero__tag::before { content: ''; width: 5px; height: 5px; border-radius: 50%; background: currentColor; }
  .ct-hero__title { margin: 0 0 20px; font-family: var(--font-heading-family); font-weight: 500; font-size: clamp(38px, 6.4vw, 80px); line-height: 1.08; color: #f5f0eb; }
  .ct-hero__sub { margin: 0 0 32px; max-width: 500px; font-size: 17px; line-height: 1.65; color: #d4cec7; }
  .ct-hero__ctas { display: flex; gap: 12px; flex-wrap: wrap; }
  .ct-hero__btn { width: auto; padding: 16px 34px; font-size: 13px; }
  .ct-hero__rating { margin: 22px 0 0; }
  .ct-hero__pill { display: inline-flex; align-items: center; gap: 10px; padding: 7px 14px 7px 12px; border-radius: 100px; background: rgba(200,149,108,.08); border: 1px solid rgba(200,149,108,.22); font-size: 13px; color: #d4cec7; }
  .ct-hero__scroll { position: absolute; z-index: 3; left: 50%; bottom: 28px; transform: translateX(-50%); display: flex; flex-direction: column; align-items: center; gap: 6px; color: #8a847c; font-size: 10px; letter-spacing: .2em; text-transform: uppercase; animation: ct-hero-bob 2.2s ease-in-out infinite; }
  .ct-hero__scroll svg { width: 18px; height: 18px; }
  @keyframes ct-hero-bob { 0%,100% { transform: translate(-50%, 0); } 50% { transform: translate(-50%, 6px); } }
  @media (max-width: 749px) {
    .ct-hero { min-height: var(--hero-min-m); align-items: flex-end; }
    {%- if s.image_mobile != blank and s.video == blank -%}
    .ct-hero__img--mobile { display: block !important; } .ct-hero__img--desktop { display: none !important; }
    {%- endif -%}
    .ct-hero__content { max-width: 100%; padding: 24px 20px {% if s.show_scroll %}72px{% else %}44px{% endif %}; }
    .ct-hero__tag { font-size: 10px; margin-bottom: 14px; }
    .ct-hero__title { font-size: 38px; line-height: 1.12; }
    .ct-hero__sub { font-size: 15px; margin-bottom: 26px; }
    .ct-hero__ctas { flex-direction: column; gap: 10px; }
    .ct-hero__btn { width: 100%; padding: 15px 22px; font-size: 12px; }
    .ct-hero__pill { font-size: 12px; padding: 6px 12px 6px 10px; }
  }
  @media (prefers-reduced-motion: reduce) { .ct-hero__scroll { animation: none; } }
</style>

{% schema %}
{
  "name": "⭐ Hero",
  "tag": "section",
  "class": "ct-section",
  "enabled_on": {
    "templates": [
      "index",
      "page",
      "collection"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Fond"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Vidéo de fond (Shopify)",
      "info": "Lecture auto en boucle sans son. Remplace l'image."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image de fond"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Image de fond mobile (optionnel)"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Assombrissement",
      "min": 0,
      "max": 90,
      "step": 5,
      "default": 45,
      "unit": "%"
    },
    {
      "type": "checkbox",
      "id": "grain",
      "label": "Effet grain",
      "default": true
    },
    {
      "type": "header",
      "content": "Contenu"
    },
    {
      "type": "text",
      "id": "tag",
      "label": "Étiquette",
      "default": "Free shipping across Australia"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Titre",
      "default": "Cook clean. Cook <em>titanium</em>.",
      "info": "Mets un mot en italique pour l'afficher en cuivre"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Sous-titre",
      "default": "Hand-hammered titanium pans with no coating to flake, chip or wear away. One pan for every meal, for years to come."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Bouton principal",
      "default": "Shop the pan"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Lien du bouton principal"
    },
    {
      "type": "text",
      "id": "button2_label",
      "label": "Bouton secondaire (optionnel)"
    },
    {
      "type": "url",
      "id": "button2_url",
      "label": "Lien du bouton secondaire"
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Texte de la pastille d'avis (vrais chiffres)"
    },
    {
      "type": "checkbox",
      "id": "show_scroll",
      "label": "Indicateur « défiler »",
      "default": true
    },
    {
      "type": "text",
      "id": "scroll_label",
      "label": "Texte de l'indicateur",
      "default": "Scroll"
    },
    {
      "type": "header",
      "content": "Hauteur"
    },
    {
      "type": "range",
      "id": "height_desktop",
      "label": "Hauteur min. (ordinateur)",
      "min": 400,
      "max": 1000,
      "step": 10,
      "default": 750,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "Hauteur min. (mobile)",
      "min": 360,
      "max": 900,
      "step": 10,
      "default": 560,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "⭐ Hero"
    }
  ]
}
{% endschema %}
