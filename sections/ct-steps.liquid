{% render 'ct-sec-open', section: section %}
{%- assign s = section.settings -%}
<section class="ct-sec ct-steps" data-ct-carousel>
  <div class="ct-wrap">
    {%- if s.pill_text != blank -%}
      <p class="ct-steps__pill-wrap"><span class="ct-pill">{%- if s.pill_image != blank -%}{{ s.pill_image | image_url: width: 80 | image_tag: alt: '' }}{%- endif -%}<span>{{ s.pill_text }}</span></span></p>
    {%- endif -%}
    {% render 'ct-head', s: s %}
    <div class="ct-track" data-ct-track style="--ct-card-w: 80%; --ct-card-w-desk: 31%;">
      {%- for block in section.blocks -%}
        <div class="ct-card ct-steps__card" {{ block.shopify_attributes }}>
          <span class="ct-steps__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <div class="ct-steps__media">
            {%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 600 | image_tag: class: 'ct-img', loading: 'lazy' }}{%- else -%}<div class="ct-ph">{{ "image" | placeholder_svg_tag }}</div>{%- endif -%}
          </div>
          {%- if block.settings.title != blank -%}<h3 class="ct-steps__title">{{ block.settings.title }}</h3>{%- endif -%}
          {%- if block.settings.text != blank -%}<p class="ct-steps__text">{{ block.settings.text }}</p>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
    <div class="ct-progress" data-ct-progress><span></span></div>
  </div>
</section>
<style>
  .ct-steps__pill-wrap { text-align: {% if s.heading_align == 'center' %}center{% else %}left{% endif %}; margin: 0 0 16px; }
  .ct-steps__pill-wrap strong, .ct-steps__pill-wrap b { font-weight: 700; }
  .ct-steps__card { position: relative; padding: 18px 16px; background: #1a1917; }
  .ct-steps__num { position: absolute; top: 10px; right: 12px; font-size: 11px; color: var(--ct-copper); letter-spacing: .1em; }
  .ct-steps__media { width: 74%; margin: 6px auto 16px; aspect-ratio: 1; border-radius: 8px; overflow: hidden; }
  .ct-steps__title { margin: 0 0 6px; font-family: var(--font-heading-family); font-weight: 400; font-size: 18px; color: var(--ct-text); }
  .ct-steps__text { margin: 0; font-size: 13px; color: var(--ct-muted); line-height: 1.5; }
</style>

{% schema %}
{
  "name": "⭐ Étapes / conseils",
  "tag": "section",
  "class": "ct-section",
  "settings": [
    {
      "type": "header",
      "content": "Pastille"
    },
    {
      "type": "image_picker",
      "id": "pill_image",
      "label": "Photo (pastille)"
    },
    {
      "type": "inline_richtext",
      "id": "pill_text",
      "label": "Texte de la pastille",
      "default": "Cooking tip from <strong>our chef</strong>"
    },
    {
      "type": "header",
      "content": "En-tête"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sur-titre"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Titre",
      "default": "How to get the <em>perfect</em> sear",
      "info": "Mets un mot en italique pour l'afficher en cuivre"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Sous-titre"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Alignement",
      "options": [
        {
          "value": "left",
          "label": "Gauche"
        },
        {
          "value": "center",
          "label": "Centré"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Fond",
      "default": "#201f1e"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Couleur d'accent (optionnel)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espace en haut",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 56,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espace en bas",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 56,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Étape",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titre",
          "default": "Preheat on medium heat"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Texte",
          "default": "Give the pan 1–2 minutes to heat evenly."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "⭐ Étapes / conseils",
      "blocks": [
        {
          "type": "step"
        },
        {
          "type": "step",
          "settings": {
            "title": "Add a thin layer of oil",
            "text": "It should shimmer when the pan is ready."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Let it release",
            "text": "Wait until the food lifts on its own before flipping."
          }
        }
      ]
    }
  ],
  "enabled_on": {
    "templates": [
      "product",
      "index",
      "page"
    ]
  }
}
{% endschema %}
