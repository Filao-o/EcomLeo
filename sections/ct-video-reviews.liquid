{% render 'ct-sec-open', section: section %}
<section class="ct-sec ct-vid" data-ct-carousel>
  <div class="ct-wrap">
    {% render 'ct-head', s: section.settings %}
    <div class="ct-track" data-ct-track style="--ct-card-w: 62%; --ct-card-w-desk: 23%;">
      {%- for block in section.blocks -%}
        <div class="ct-vid__card" {{ block.shopify_attributes }}>
          {%- if block.settings.video != blank -%}
            {{ block.settings.video | video_tag: muted: true, loop: true, playsinline: true, preload: 'none', class: 'ct-img', image_size: '600x' }}
          {%- elsif block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 600 | image_tag: class: 'ct-img', loading: 'lazy' }}
          {%- else -%}<div class="ct-ph">{{ "image" | placeholder_svg_tag }}</div>{%- endif -%}
          {%- if block.settings.video != blank -%}<button class="ct-vid__play" type="button" aria-label="Play"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" fill="currentColor"/></svg></button>{%- endif -%}
          {%- if block.settings.caption != blank -%}<p class="ct-vid__cap">{{ block.settings.caption }}</p>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
<style>
  .ct-vid__card { position: relative; aspect-ratio: 9 / 15; border-radius: 12px; overflow: hidden; background: #2f2c2a; }
  .ct-vid__card video { object-fit: cover; }
  .ct-vid__play { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: 44px; height: 44px; border-radius: 50%; border: 0; background: rgba(0,0,0,.55); color: #fff; display: flex; align-items: center; justify-content: center; cursor: pointer; }
  .ct-vid__play svg { width: 20px; height: 20px; margin-left: 2px; }
  .ct-vid__card.is-playing .ct-vid__play { opacity: 0; }
  .ct-vid__cap { position: absolute; left: 0; right: 0; bottom: 0; margin: 0; padding: 24px 12px 12px; font-size: 13px; background: linear-gradient(transparent, rgba(0,0,0,.7)); }
</style>
<script>
  document.querySelectorAll('#shopify-section-{{ section.id }} .ct-vid__card').forEach(function (card) {
    var v = card.querySelector('video'); if (!v) return;
    card.addEventListener('click', function () {
      if (v.paused) {
        // Une seule vidéo à la fois, lancée avec le son (clic = geste utilisateur, le navigateur l'autorise)
        document.querySelectorAll('#shopify-section-{{ section.id }} .ct-vid__card.is-playing').forEach(function (c) {
          var o = c.querySelector('video'); if (o && o !== v) { o.pause(); c.classList.remove('is-playing'); }
        });
        v.muted = false; v.volume = 1; v.play(); card.classList.add('is-playing');
      } else { v.pause(); card.classList.remove('is-playing'); }
    });
  });
</script>

{% schema %}
{
  "name": "⭐ Vidéos clients",
  "tag": "section",
  "class": "ct-section",
  "settings": [
    {
      "type": "header",
      "content": "En-tête"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sur-titre",
      "default": "Real cooks, real results"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Titre",
      "info": "Mets un mot en italique pour l'afficher en cuivre"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Sous-titre"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Alignement",
      "options": [
        {
          "value": "left",
          "label": "Gauche"
        },
        {
          "value": "center",
          "label": "Centré"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Fond",
      "default": "#201f1e"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Couleur d'accent (optionnel)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espace en haut",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espace en bas",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 40,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Vidéo",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Vidéo (hébergée sur Shopify)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (si pas de vidéo)"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Légende"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "⭐ Vidéos clients",
      "blocks": [
        {
          "type": "video"
        },
        {
          "type": "video"
        },
        {
          "type": "video"
        }
      ]
    }
  ],
  "enabled_on": {
    "templates": [
      "product",
      "index",
      "page"
    ]
  }
}
{% endschema %}
