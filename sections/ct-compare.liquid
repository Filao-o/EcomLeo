{% render 'ct-sec-open', section: section %}
{%- assign s = section.settings -%}
{%- assign ncols = 0 -%}
{%- for i in (1..6) -%}{%- assign k = 'col_' | append: i -%}{%- if s[k] != blank -%}{%- assign ncols = i -%}{%- endif -%}{%- endfor -%}
<section class="ct-sec ct-cmp">
  <div class="ct-wrap">
    {% render 'ct-head', s: s %}
    <div class="ct-cmp__scroll">
      <table class="ct-cmp__table" style="--cmp-cols: {{ ncols }};">
        <colgroup><col class="c-lbl"><col class="c-brand">{%- for i in (2..ncols) -%}<col>{%- endfor -%}</colgroup>
        <thead><tr><th></th>
          {%- for i in (1..ncols) -%}{%- assign k = 'col_' | append: i -%}<th class="{% if i == 1 %}is-hl{% endif %}">{% if i == 1 %}<span class="ct-cmp__brand">{{ s[k] }}</span>{% else %}{{ s[k] }}{% endif %}</th>{%- endfor -%}
        </tr></thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <td class="ct-cmp__label">{{ block.settings.label }}</td>
              {%- for i in (1..ncols) -%}
                {%- assign k = 'val_' | append: i -%}{%- assign v = block.settings[k] | strip -%}{%- assign vd = v | downcase -%}
                <td class="{% if i == 1 %}is-hl{% endif %}">
                  {%- if vd == 'yes' or vd == 'oui' or v == '✓' -%}{% if i == 1 %}<span class="ct-check"><svg viewBox="0 0 24 24"><path d="M6 12.5l4 4 8-9" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></span>{% else %}<span class="ct-cmp__tick"><svg viewBox="0 0 24 24"><path d="M6 12.5l4 4 8-9" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></span>{% endif %}
                  {%- elsif vd == 'no' or vd == 'non' or v == '✗' -%}<span class="ct-x"><svg viewBox="0 0 24 24"><path d="M7 7l10 10M17 7L7 17" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round"/></svg></span>
                  {%- else -%}<span class="ct-cmp__txt">{{ v }}</span>{%- endif -%}
                </td>
              {%- endfor -%}
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
    {%- if s.footnote != blank -%}<div class="ct-cmp__note">{% render 'pdp-icon', icon: 'shield' %}<div>{{ s.footnote }}</div></div>{%- endif -%}
  </div>
</section>
<style>
  /* Ordinateur : colonnes larges, défilement si besoin */
  .ct-cmp__scroll { overflow-x: auto; margin: 0 calc(var(--ct-gutter) * -1); padding: 0 var(--ct-gutter); scrollbar-width: none; }
  .ct-cmp__scroll::-webkit-scrollbar { display: none; }
  .ct-cmp__table { width: 100%; table-layout: fixed; border-collapse: separate; border-spacing: 8px 0; font-size: 13px; }
  .ct-cmp__table col.c-lbl { width: 22%; } .ct-cmp__table col.c-brand { width: 15%; }
  .ct-cmp__table th { padding: 14px 6px; font-weight: 600; font-size: 12px; line-height: 1.2; color: var(--ct-text); background: rgba(255,255,255,.03); border-radius: 8px 8px 0 0; overflow-wrap: normal; word-break: normal; hyphens: none; }
  .ct-cmp__table td { height: 54px; padding: 8px 6px; text-align: center; vertical-align: middle; background: rgba(255,255,255,.03); border-top: 1px solid var(--ct-border); }
  .ct-cmp__table th:first-child, .ct-cmp__table td.ct-cmp__label { background: none; text-align: left; padding-left: 0; }
  .ct-cmp__label { color: var(--ct-text); font-size: 14px; font-weight: 500; line-height: 1.3; }
  .ct-cmp__table .is-hl { background: rgba(200,149,108,.1); border-left: 1px solid rgba(200,149,108,.45); border-right: 1px solid rgba(200,149,108,.45); }
  .ct-cmp__table th.is-hl { border-top: 1px solid rgba(200,149,108,.45); }
  .ct-cmp__table tr:last-child td.is-hl { border-bottom: 1px solid rgba(200,149,108,.45); border-radius: 0 0 8px 8px; }
  .ct-cmp__brand { font-family: var(--font-heading-family); font-size: 15px; font-weight: 400; letter-spacing: .04em; }
  .ct-cmp__tick { color: var(--ct-text); display: inline-flex; }
  .ct-cmp__tick svg { width: 13px; height: 13px; }
  .ct-cmp__table .ct-check, .ct-cmp__table .ct-x { margin: 0 auto; }
  .ct-cmp__txt { color: var(--ct-muted); font-size: 12px; line-height: 1.2; }
  .is-hl .ct-cmp__txt { color: var(--ct-copper); font-weight: 600; }
  .ct-cmp__note { display: flex; gap: 10px; align-items: flex-start; justify-content: center; margin-top: 28px; color: var(--ct-muted); font-size: 14px; text-align: center; }
  .ct-cmp__note .pdp-icon { flex: none; width: 18px; height: 18px; color: var(--ct-copper); }
  .ct-cmp__note p { margin: 0; } .ct-cmp__note strong { color: var(--ct-copper); }

  /* Mobile : tout tient dans la largeur de l'écran, sans défilement */
  @media (max-width: 749px) {
    .ct-cmp__scroll { overflow: visible; margin: 0; padding: 0; }
    .ct-cmp__table { border-spacing: 3px 0; font-size: 10px; }
    .ct-cmp__table col.c-lbl { width: 27%; } .ct-cmp__table col.c-brand { width: 16%; }
    .ct-cmp__table th { padding: 8px 0; font-size: 8.5px; letter-spacing: -.01em; }
    .ct-cmp__table td { height: 42px; padding: 4px 1px; }
    .ct-cmp__label { font-size: 11px; line-height: 1.25; padding-right: 4px !important; }
    .ct-cmp__brand { display: block; font-size: 8.5px; letter-spacing: -.02em; white-space: nowrap; line-height: 1.15; }
    .ct-cmp__table col.c-brand { width: 17%; }
    .ct-cmp__table .ct-check { width: 18px; height: 18px; } .ct-cmp__table .ct-check svg { width: 9px; height: 9px; }
    .ct-cmp__table .ct-x { width: 15px; height: 15px; } .ct-cmp__table .ct-x svg { width: 6px; height: 6px; }
    .ct-cmp__tick svg { width: 10px; height: 10px; }
    .ct-cmp__txt { font-size: 9.5px; line-height: 1.15; }
    .ct-cmp__note { font-size: 12.5px; margin-top: 22px; }
  }
</style>

{% schema %}
{
  "name": "⭐ Tableau comparatif",
  "tag": "section",
  "class": "ct-section",
  "settings": [
    {
      "type": "header",
      "content": "En-tête"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sur-titre",
      "default": "Why titanium?"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Titre",
      "default": "Titanium vs the <em>rest</em>",
      "info": "Mets un mot en italique pour l'afficher en cuivre"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Sous-titre",
      "default": "A cleaner, longer-lasting way to cook."
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Alignement",
      "options": [
        {
          "value": "left",
          "label": "Gauche"
        },
        {
          "value": "center",
          "label": "Centré"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Colonnes (la 1re est mise en avant)"
    },
    {
      "type": "text",
      "id": "col_1",
      "label": "Colonne 1 (ta marque)",
      "default": "CookingTitan"
    },
    {
      "type": "text",
      "id": "col_2",
      "label": "Colonne 2",
      "default": "Non-stick"
    },
    {
      "type": "text",
      "id": "col_3",
      "label": "Colonne 3",
      "default": "Steel"
    },
    {
      "type": "text",
      "id": "col_4",
      "label": "Colonne 4",
      "default": "Cast iron"
    },
    {
      "type": "text",
      "id": "col_5",
      "label": "Colonne 5",
      "default": "Ceramic"
    },
    {
      "type": "text",
      "id": "col_6",
      "label": "Colonne 6"
    },
    {
      "type": "richtext",
      "id": "footnote",
      "label": "Note sous le tableau",
      "default": "<p>Add your warranty or guarantee here.</p>"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Fond",
      "default": "#201f1e"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Couleur d'accent (optionnel)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espace en haut",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 56,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espace en bas",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 56,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Ligne",
      "settings": [
        {
          "type": "paragraph",
          "content": "Valeurs : « yes » = coche, « no » = croix, sinon le texte s'affiche."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Critère",
          "default": "Non-toxic surface"
        },
        {
          "type": "text",
          "id": "val_1",
          "label": "Colonne 1",
          "default": "yes"
        },
        {
          "type": "text",
          "id": "val_2",
          "label": "Colonne 2",
          "default": "no"
        },
        {
          "type": "text",
          "id": "val_3",
          "label": "Colonne 3",
          "default": "yes"
        },
        {
          "type": "text",
          "id": "val_4",
          "label": "Colonne 4",
          "default": "yes"
        },
        {
          "type": "text",
          "id": "val_5",
          "label": "Colonne 5",
          "default": "no"
        },
        {
          "type": "text",
          "id": "val_6",
          "label": "Colonne 6"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "⭐ Tableau comparatif",
      "blocks": [
        {
          "type": "row"
        },
        {
          "type": "row",
          "settings": {
            "label": "Easy to clean",
            "val_3": "no"
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "Dishwasher safe",
            "val_4": "no"
          }
        }
      ]
    }
  ],
  "enabled_on": {
    "templates": [
      "product",
      "index",
      "page"
    ]
  }
}
{% endschema %}
