{%- comment -%}
  Bibliothèque d'icônes pour les blocs PDP. Usage : {% render 'pdp-icon', icon: 'shield' %}
{%- endcomment -%}
{%- if icon == 'flag_au' -%}
<svg class="pdp-icon pdp-icon--flag" viewBox="0 0 60 30" aria-hidden="true" focusable="false">
  <rect width="60" height="30" fill="#012169"/>
  <path d="M0 0l30 15M30 0L0 15" stroke="#fff" stroke-width="3"/>
  <path d="M0 0l30 15M30 0L0 15" stroke="#E4002B" stroke-width="1.2"/>
  <path d="M15 0v15M0 7.5h30" stroke="#fff" stroke-width="5"/>
  <path d="M15 0v15M0 7.5h30" stroke="#E4002B" stroke-width="3"/>
  <g fill="#fff">
    <path d="M15 19.5l1 3 3-.9-1.8 2.6 2.6 1.8-3.1.3.3 3.1-2-2.4-2 2.4.3-3.1-3.1-.3 2.6-1.8-1.8-2.6 3 .9z"/>
    <circle cx="45" cy="6" r="1.6"/><circle cx="39" cy="13" r="1.6"/><circle cx="51" cy="11.5" r="1.6"/>
    <circle cx="45" cy="24" r="1.8"/><circle cx="48" cy="16.5" r="1"/>
  </g>
</svg>
{%- else -%}
<svg class="pdp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case icon -%}
    {%- when 'check_circle' -%}<circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.7 2.7L16 9.8"/>
    {%- when 'shield' -%}<path d="M12 3l7 3v5.5c0 4.4-3 8.2-7 9.5-4-1.3-7-5.1-7-9.5V6z"/><path d="M9.5 12l1.8 1.8 3.4-3.6"/>
    {%- when 'dishwasher' -%}<rect x="5" y="3" width="14" height="18" rx="2"/><path d="M5 7.5h14"/><circle cx="12" cy="14" r="3.5"/><path d="M8 5.2h.01M10.5 5.2h.01"/>
    {%- when 'flame' -%}<path d="M12 21c3.6 0 6-2.5 6-5.8 0-3.6-2.6-5.6-3.6-8.7-.3 1.9-1.3 3-2.4 3.6.2-2.7-1-5.4-3.4-7.1.2 3.2-3 5.7-3 9.9C5.6 18.4 8.2 21 12 21z"/>
    {%- when 'leaf' -%}<path d="M5 19c0-8 5-13 14-14-.5 9-5.5 14-13 14"/><path d="M5 19l7-7"/>
    {%- when 'truck' -%}<path d="M3 6h11v9H3zM14 9h4l3 3v3h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/>
    {%- when 'star' -%}<path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z"/>
    {%- when 'heart' -%}<path d="M12 20s-7-4.4-7-10a4 4 0 017-2.6A4 4 0 0119 10c0 5.6-7 10-7 10z"/>
    {%- when 'return' -%}<path d="M4 9h11a5 5 0 010 10H8"/><path d="M8 5L4 9l4 4"/>
    {%- when 'lock' -%}<rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 018 0v3"/>
    {%- when 'medal' -%}<circle cx="12" cy="14" r="5"/><path d="M8.5 9.5L6 3h4l2 4 2-4h4l-2.5 6.5"/>
    {%- when 'gas_stove' -%}<rect x="3" y="12" width="18" height="8" rx="1.5"/><circle cx="8" cy="16" r="1.4"/><circle cx="16" cy="16" r="1.4"/><path d="M6 12V10.5h12V12"/><path d="M12 9.5c1.6 0 2.4-1.1 2.4-2.3 0-1.5-1.2-2.2-1.6-3.7-.5 1-1 1.5-1.6 1.8 0-1-.4-1.8-1.1-2.3.1 1.5-1 2.4-1 4.2 0 1.2.9 2.3 2.9 2.3z"/>
    {%- when 'induction' -%}<rect x="3" y="11" width="18" height="9" rx="1.5"/><ellipse cx="12" cy="15.5" rx="5" ry="2.2"/><ellipse cx="12" cy="15.5" rx="2.2" ry="1"/><path d="M8.5 4.5c.8.8.8 1.7 0 2.5s-.8 1.7 0 2.5M12 4.5c.8.8.8 1.7 0 2.5s-.8 1.7 0 2.5M15.5 4.5c.8.8.8 1.7 0 2.5s-.8 1.7 0 2.5"/>
    {%- when 'oven' -%}<rect x="4" y="3" width="16" height="18" rx="2"/><path d="M4 8h16"/><rect x="7" y="11" width="10" height="7" rx="1"/><path d="M7.5 5.5h.01M10 5.5h.01M16 5.5h1"/>
    {%- when 'grill' -%}<path d="M4 9h16l-1.5 5.5a3 3 0 01-2.9 2.2H8.4a3 3 0 01-2.9-2.2z"/><path d="M8 16.7L6.5 21M16 16.7l1.5 4.3M12 16.7V21"/><path d="M7 9V7.5M12 9V6.5M17 9V7.5"/><path d="M8.5 12h7"/>
    {%- when 'electric' -%}<circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.6"/>
    {%- when 'ceramic' -%}<circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="4.5" stroke-dasharray="1.6 1.8"/>
    {%- when 'gift' -%}<rect x="4" y="9" width="16" height="11" rx="1.5"/><path d="M3 9h18v-3H3zM12 6v14M12 6c-1.5-3-5-3-5-1s2.5 1 5 1zM12 6c1.5-3 5-3 5-1s-2.5 1-5 1z"/>
    {%- when 'document' -%}<path d="M7 3h7l4 4v14H7z"/><path d="M14 3v4h4M9.5 12h6M9.5 15.5h6"/>
    {%- when 'drop' -%}<path d="M12 3.5c3 4 5.5 6.8 5.5 10a5.5 5.5 0 01-11 0c0-3.2 2.5-6 5.5-10z"/>
    {%- when 'box' -%}<path d="M12 3l8 4.5v9L12 21l-8-4.5v-9z"/><path d="M4 7.5l8 4.5 8-4.5M12 12v9"/>
    {%- when 'ruler' -%}<rect x="3" y="8" width="18" height="8" rx="1.5"/><path d="M7 8v3M11 8v4M15 8v3M19 8v4"/>
    {%- when 'pin' -%}<path d="M12 21s-6.5-6-6.5-11a6.5 6.5 0 0113 0c0 5-6.5 11-6.5 11z"/><circle cx="12" cy="10" r="2.3"/>
    {%- when 'instagram' -%}<rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17" cy="7" r=".8"/>
    {%- when 'snowflake' -%}<path d="M12 3v18M4.2 7.5l15.6 9M4.2 16.5l15.6-9"/>
    {%- else -%}<circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.7 2.7L16 9.8"/>
  {%- endcase -%}
</svg>
{%- endif -%}
