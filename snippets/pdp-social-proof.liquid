{%- comment -%}
  Bloc « Badge preuve sociale » (ex : The Choice of Professional Chefs)
  Rendu depuis product-info.liquid -> block.type == 'pdp_social_proof'
{%- endcomment -%}
{%- liquid
  assign s = block.settings
  assign avatar_size = s.avatar_size | default: 24
-%}
<div
  class="pdp-social-proof pdp-social-proof--{{ block.id }}"
  {{ block.shopify_attributes }}
  style="
    --sp-bg: {{ s.background_color }};
    --sp-border: {{ s.border_color }};
    --sp-text: {{ s.text_color }};
    --sp-radius: {{ s.border_radius }}px;
    --sp-avatar: {{ avatar_size }}px;
    --sp-font-size: {{ s.font_size }}px;
    --sp-verified: {{ s.verified_color }};
    --sp-avatar-border: {{ s.avatar_border_color }};
    margin-top: {{ s.margin_top }}px;
    margin-bottom: {{ s.margin_bottom }}px;
  "
>
  {%- if s.link != blank -%}<a href="{{ s.link }}" class="pdp-social-proof__inner">{%- else -%}<div class="pdp-social-proof__inner">{%- endif -%}
    {%- assign has_avatar = false -%}
    {%- if s.avatar_1 != blank or s.avatar_2 != blank or s.avatar_3 != blank -%}{%- assign has_avatar = true -%}{%- endif -%}
    {%- if has_avatar -%}
      <span class="pdp-social-proof__avatars">
        {%- for i in (1..3) -%}
          {%- liquid
            assign key = 'avatar_' | append: i
            assign img = s[key]
          -%}
          {%- if img != blank -%}
            {{ img | image_url: width: 96 | image_tag: class: 'pdp-social-proof__avatar', loading: 'lazy', alt: img.alt, width: avatar_size, height: avatar_size }}
          {%- endif -%}
        {%- endfor -%}
      </span>
    {%- endif -%}
    <span class="pdp-social-proof__text">{{ s.text }}</span>
    {%- if s.show_verified -%}
      <svg class="pdp-social-proof__verified" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path fill="currentColor" d="M12 1.5l2.6 1.9 3.2-.1 1 3.1 2.6 1.9-1 3.1 1 3.1-2.6 1.9-1 3.1-3.2-.1L12 22.5l-2.6-1.9-3.2.1-1-3.1-2.6-1.9 1-3.1-1-3.1 2.6-1.9 1-3.1 3.2.1z"/>
        <path fill="#fff" d="M10.6 15.6l-3.2-3.2 1.4-1.4 1.8 1.8 4.6-4.6 1.4 1.4z"/>
      </svg>
    {%- endif -%}
  {%- if s.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
</div>
