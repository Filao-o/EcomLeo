{%- comment -%}
  Bloc « Cartes avantages » (grille 2x2 : icône + titre + sous-titre)
  block.type == 'pdp_feature_cards'
{%- endcomment -%}
{%- assign s = block.settings -%}
<div
  class="pdp-features"
  {{ block.shopify_attributes }}
  style="
    --ft-cols: {{ s.columns_desktop }};
    --ft-cols-mobile: {{ s.columns_mobile }};
    --ft-bg: {{ s.card_bg_color }};
    --ft-border: {{ s.card_border_color }};
    --ft-radius: {{ s.card_radius }}px;
    --ft-icon-bg: {{ s.icon_bg_color }};
    --ft-icon-border: {{ s.icon_border_color }};
    --ft-icon: {{ s.icon_color }};
    --ft-title: {{ s.title_color }};
    --ft-sub: {{ s.subtitle_color }};
    --ft-title-size: {{ s.title_size }}px;
    --ft-sub-size: {{ s.subtitle_size }}px;
    margin-top: {{ s.margin_top }}px;
    margin-bottom: {{ s.margin_bottom }}px;
  "
>
  {%- for i in (1..4) -%}
    {%- liquid
      assign k_title = 'feature_' | append: i | append: '_title'
      assign k_sub = 'feature_' | append: i | append: '_subtitle'
      assign k_icon = 'feature_' | append: i | append: '_icon'
      assign k_img = 'feature_' | append: i | append: '_image'
      assign f_title = s[k_title]
      assign f_sub = s[k_sub]
      assign f_icon = s[k_icon]
      assign f_img = s[k_img]
    -%}
    {%- if f_title != blank or f_sub != blank -%}
      <div class="pdp-features__card">
        {%- if f_icon != 'none' or f_img != blank -%}
          <span class="pdp-features__icon">
            {%- if f_img != blank -%}
              {{ f_img | image_url: width: 64 | image_tag: loading: 'lazy', alt: f_title }}
            {%- else -%}
              {% render 'pdp-icon', icon: f_icon %}
            {%- endif -%}
          </span>
        {%- endif -%}
        <span class="pdp-features__text">
          {%- if f_title != blank -%}<span class="pdp-features__title">{{ f_title }}</span>{%- endif -%}
          {%- if f_sub != blank -%}<span class="pdp-features__subtitle">{{ f_sub }}</span>{%- endif -%}
        </span>
      </div>
    {%- endif -%}
  {%- endfor -%}
</div>
