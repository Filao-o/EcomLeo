{%- comment -%}
  Modification de la poêle dans le tiroir panier : taille + ajout du couvercle.
  Rendu uniquement pour un produit à 2 options dont l'une contient « lid ».
  Paramètre : item (line item)
{%- endcomment -%}
{%- liquid
  assign lid_pos = 0
  assign size_pos = 0
  for opt in item.product.options_with_values
    assign opt_values = opt.values | join: '|' | downcase
    if opt_values contains 'lid'
      assign lid_pos = forloop.index
    else
      assign size_pos = forloop.index
    endif
  endfor
-%}
{%- if lid_pos > 0 and size_pos > 0 and item.product.options.size == 2 -%}
  {%- liquid
    assign size_idx = size_pos | minus: 1
    assign size_opt = item.product.options_with_values[size_idx]
    if size_pos == 1
      assign cur_size = item.variant.option1
    else
      assign cur_size = item.variant.option2
    endif
    if lid_pos == 1
      assign cur_lid = item.variant.option1
    else
      assign cur_lid = item.variant.option2
    endif
    assign cur_lid_down = cur_lid | downcase
    assign without_lid = false
    if cur_lid_down contains 'without' or cur_lid_down contains 'no lid' or cur_lid_down contains 'sans'
      assign without_lid = true
    endif
    assign lid_variant = null
    assign lid_value = ''
    for v in item.product.variants
      if size_pos == 1
        assign v_size = v.option1
        assign v_lid = v.option2
      else
        assign v_size = v.option2
        assign v_lid = v.option1
      endif
      assign v_lid_down = v_lid | downcase
      if v_size == cur_size and v_lid != cur_lid and v_lid_down contains 'lid'
        assign v_is_without = false
        if v_lid_down contains 'without' or v_lid_down contains 'no lid' or v_lid_down contains 'sans'
          assign v_is_without = true
        endif
        if without_lid and v_is_without == false
          assign lid_variant = v
          assign lid_value = v_lid
        elsif without_lid == false and v_is_without
          assign lid_variant = v
          assign lid_value = v_lid
        endif
      endif
    endfor
    if lid_variant
      if without_lid
        assign lid_on_value = lid_value
        assign lid_off_value = cur_lid
        assign lid_delta = lid_variant.price | minus: item.variant.price
      else
        assign lid_on_value = cur_lid
        assign lid_off_value = lid_value
        assign lid_delta = item.variant.price | minus: lid_variant.price
      endif
    endif
  -%}
  <div
    class="ct-ce"
    data-key="{{ item.key }}"
    data-qty="{{ item.quantity }}"
    data-size-pos="{{ size_pos }}"
    data-lid-pos="{{ lid_pos }}"
    data-cur-lid="{{ cur_lid | escape }}"
  >
    <script type="application/json" data-ct-ce-variants>
      [{%- for v in item.product.variants -%}{%- assign v_q = 0 -%}{%- for ci in cart.items -%}{%- if ci.variant_id == v.id -%}{%- assign v_q = v_q | plus: ci.quantity -%}{%- endif -%}{%- endfor -%}{"id":{{ v.id }},"o1":{{ v.option1 | json }},"o2":{{ v.option2 | json }},"a":{{ v.available | json }},"q":{{ v_q }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]
    </script>
    <script type="application/json" data-ct-ce-props>{{ item.properties | json }}</script>
    <p class="ct-ce__sum">
      <span>{{ cur_size }} · {{ cur_lid }}</span>
      <button type="button" class="ct-ce__edit" aria-expanded="false">Edit</button>
    </p>
    <div class="ct-ce__panel" hidden>
    <label class="ct-ce__row">
      <span class="ct-ce__label">{{ size_opt.name | remove: 'Choose your ' | capitalize }}</span>
      <span class="ct-ce__select-wrap">
        <select class="ct-ce__size" aria-label="{{ size_opt.name | escape }}">
          {%- for val in size_opt.values -%}
            <option value="{{ val | escape }}"{% if val == cur_size %} selected{% endif %}>{{ val }}</option>
          {%- endfor -%}
        </select>
      </span>
    </label>
    </div>
    {%- if lid_variant -%}
      <label class="ct-ce__lid">
        <input type="checkbox" role="switch" class="ct-ce__lid-input" data-on-value="{{ lid_on_value | escape }}" data-off-value="{{ lid_off_value | escape }}"{% unless without_lid %} checked{% endunless %}>
        <span class="ct-ce__switch" aria-hidden="true"></span>
        <span>Add the glass lid{% if lid_delta > 0 %} <strong>+{{ lid_delta | money }}</strong>{% endif %}</span>
      </label>
    {%- endif -%}
  </div>
{%- endif -%}
