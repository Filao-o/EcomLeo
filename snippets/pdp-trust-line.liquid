{%- comment -%}
  Bloc « Ligne de réassurance » : 🇦🇺 Free shipping to Australia · ↩ 30-day returns
  block.type == 'pdp_trust_line'
{%- endcomment -%}
{%- assign s = block.settings -%}
<div
  class="pdp-trust{% if s.divider_top %} pdp-trust--top{% endif %}{% if s.divider_bottom %} pdp-trust--bottom{% endif %}"
  {{ block.shopify_attributes }}
  style="
    --tr-text: {{ s.text_color }};
    --tr-icon: {{ s.icon_color }};
    --tr-divider: {{ s.divider_color }};
    --tr-size: {{ s.font_size }}px;
    --tr-pad: {{ s.padding }}px;
    --tr-align: {{ s.alignment }};
    margin-top: {{ s.margin_top }}px;
    margin-bottom: {{ s.margin_bottom }}px;
  "
>
  {%- assign shown = 0 -%}
  {%- for i in (1..3) -%}
    {%- liquid
      assign k_text = 'item_' | append: i | append: '_text'
      assign k_icon = 'item_' | append: i | append: '_icon'
      assign k_img = 'item_' | append: i | append: '_image'
      assign it_text = s[k_text]
      assign it_icon = s[k_icon]
      assign it_img = s[k_img]
    -%}
    {%- if it_text != blank -%}
      {%- if shown > 0 -%}<span class="pdp-trust__sep" aria-hidden="true">•</span>{%- endif -%}
      <span class="pdp-trust__item">
        {%- if it_img != blank -%}
          {{ it_img | image_url: width: 64 | image_tag: loading: 'lazy', alt: '', class: 'pdp-trust__img' }}
        {%- elsif it_icon != 'none' -%}
          {% render 'pdp-icon', icon: it_icon %}
        {%- endif -%}
        <span>{{ it_text }}</span>
      </span>
      {%- assign shown = shown | plus: 1 -%}
    {%- endif -%}
  {%- endfor -%}
</div>
